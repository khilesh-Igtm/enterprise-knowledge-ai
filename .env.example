# Application
APP_NAME=Enterprise Knowledge AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_ai

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/knowledge_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333


# Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=50

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=75


GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CHAT_TOP_K=6
CHAT_SCORE_THRESHOLD=0.35
CHAT_MAX_CONTEXT_TOKENS=6000
CHAT_MAX_ANSWER_TOKENS=1200
CHAT_HISTORY_MESSAGES=8