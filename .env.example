# Application
APP_NAME=Enterprise Knowledge AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_ai

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/knowledge_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333